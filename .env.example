# DeepSeek chat model settings (required for query / grading)
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Embedding model settings (Alibaba DashScope by default)
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Vector store directory (optional)
CHROMA_PERSIST_DIR=./chroma_db

# Maximum number of documents to retrieve per query (optional)
RETRIEVER_TOP_K=4
RETRIEVAL_MAX_HOPS=2
MIN_RELEVANT_CHUNKS_TO_ANSWER=2
MAX_VALIDATION_RETRIES=1
ANSWER_VALIDATION_MIN_CONFIDENCE=0.65

# SerpApi (Hello Agents tool demo / scripts/tool_demo.py)
# SERPAPI_API_KEY=your-serpapi-key

# Agent web search tool (mock provider works without external credentials)
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=mock
WEB_SEARCH_TOP_K=3
# WEB_SEARCH_PROVIDER=tavily
# WEB_SEARCH_API_KEY=tvly-...
# WEB_SEARCH_TIMEOUT_SECONDS=10
# WEB_SEARCH_TAVILY_SEARCH_DEPTH=basic
# WEB_SEARCH_TAVILY_INCLUDE_RAW_CONTENT=false
# WEB_SEARCH_TAVILY_MAX_RAW_CONTENT_CHARS=1000

# Agent MCP tool server / client (local tools remain default when MCP is disabled)
MCP_ENABLED=false
MCP_TOOLS_URL=http://127.0.0.1:8001/mcp
MCP_TOOL_NAME_PREFIX=true
MCP_FALLBACK_TO_LOCAL=true
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_TOOL_DEFAULT_MAX_RETRIES=1

# LangSmith tracing for React and Plan-Execute agent runs (optional)
# LANGSMITH_TRACING_ENABLED controls enablement; LANGCHAIN_TRACING_V2 is written by the app when enabled.
# LANGSMITH_API_KEY is required for export when tracing is enabled.
LANGSMITH_TRACING_ENABLED=false
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ragEnlighten
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# FastAPI settings (optional)
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
